{
  "name": "karentoroku-api",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@prisma/client": "^4.12.0",
    "@yarnpkg/pnpify": "^4.0.0-rc.40",
    "add": "^2.0.6",
    "axios": "^1.3.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "firebase-admin": "^11.5.0",
    "fp-ts": "^2.13.1",
    "io-ts": "^2.2.20",
    "io-ts-extra": "^0.11.6",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.2",
    "yarn": "^1.22.19"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.3",
    "@types/supertest": "^6.0.3",
    "jest": "^29.5.0",
    "pre-commit": "^1.2.2",
    "prisma": "^4.12.0",
    "rimraf": "^4.4.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.2"
  },
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register src/main.ts",
    "start": "ts-node -r tsconfig-paths/register src/main",
    "build": "rimraf dist && tsc",
    "ts-check": "tsc --project tsconfig.json",
    "add-build": "git add dist",
    "serve": "node dist/main.js",
    "prisma:merge": "powershell -Command \"Get-Content prisma/schema/*.prisma | Set-Content prisma/schema.prisma\"",
    "prisma:use-sqlite": "copy prisma\\schema\\index.sqlite.prisma prisma\\schema\\index.prisma && yarn prisma:merge",
    "prisma:use-postgres": "copy prisma\\schema\\index.postgresql.prisma prisma\\schema\\index.prisma && yarn prisma:merge",
    "prisma:setup-sqlite": "yarn prisma:use-sqlite && yarn prisma:generate && npx prisma migrate dev --name init",
    "prisma:format": "npx prisma format",
    "prisma:migrate": "npx prisma migrate dev --name init --schema prisma/schema.prisma",
    "prisma:generate": "yarn pnpify prisma generate --schema=prisma/schema.prisma",
    "test": "jest --verbose",
    "test:karentoroku": "jest -- src/karentoroku",
    "prisma:dev": "prisma migrate dev --name init && prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "emulators": "firebase emulators:start --only auth"
  },
  "pre-commit": [
    "ts-check",
    "build",
    "add-build"
  ]
}
